# Copia este archivo como .dev.vars (local, gitignoreado) o define los valores como
# secrets de Cloudflare (pnpm wrangler secret put <KEY>) / vars de CI. Nunca commitear valores.
WIX_CLIENT_ID=
WIX_API_KEY=
WIX_SITE_ID=
WIX_CLIENT_SECRET=
# Feature flags (build-time via import.meta.env; copialos tambien al .env del build)
# AUTH_FORGOT_ENABLED: muestra el link "Forgot your password?" en /login/ (true|false)
AUTH_FORGOT_ENABLED=false
