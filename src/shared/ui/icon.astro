---
import arrowUpRight from "@phosphor-icons/core/assets/light/arrow-up-right-light.svg?raw";
import arrowLeft from "@phosphor-icons/core/assets/light/arrow-left-light.svg?raw";
import arrowRight from "@phosphor-icons/core/assets/light/arrow-right-light.svg?raw";
import arrowDown from "@phosphor-icons/core/assets/light/arrow-down-light.svg?raw";
import clock from "@phosphor-icons/core/assets/light/clock-light.svg?raw";
import envelope from "@phosphor-icons/core/assets/light/envelope-simple-light.svg?raw";
import gift from "@phosphor-icons/core/assets/light/gift-light.svg?raw";
import instagram from "@phosphor-icons/core/assets/light/instagram-logo-light.svg?raw";
import mapPin from "@phosphor-icons/core/assets/light/map-pin-light.svg?raw";
import phone from "@phosphor-icons/core/assets/light/phone-light.svg?raw";
import plus from "@phosphor-icons/core/assets/light/plus-light.svg?raw";
import search from "@phosphor-icons/core/assets/light/magnifying-glass-light.svg?raw";
import star from "@phosphor-icons/core/assets/fill/star-fill.svg?raw";
import starHalf from "@phosphor-icons/core/assets/fill/star-half-fill.svg?raw";

const icons = {
  arrowUpRight,
  arrowLeft,
  arrowRight,
  arrowDown,
  clock,
  envelope,
  gift,
  instagram,
  mapPin,
  phone,
  plus,
  search,
  star,
  starHalf,
};

interface Props {
  name: keyof typeof icons;
  class?: string;
  [key: string]: unknown;
}

const { name, class: className = "size-4", ...rest } = Astro.props;
const extra = Object.entries(rest)
  .filter(([, value]) => ["string", "boolean", "number"].includes(typeof value))
  .map(([key, value]) => ` ${key}="${String(value).replaceAll('"', "&quot;")}"`)
  .join("");
const svg = icons[name].replace(
  "<svg ",
  `<svg aria-hidden="true" focusable="false" class="${className}"${extra} `,
);
---

<Fragment set:html={svg} />
