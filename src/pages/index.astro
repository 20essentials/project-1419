---
export const prerender = true;

import Layout from '../layouts/layout.astro';
import ScrollWorld from '../components/scroll-world.astro';
import Tagline from '../components/tagline.astro';
import Dishes from '../components/dishes.astro';
import Press from '../components/press.astro';
import Experiences from '../components/experiences.astro';
import Faq from '../components/faq.astro';
import Gift from '../components/gift.astro';
import FinalCta from '../components/final-cta.astro';
import { getT, type Locale } from '../i18n/t';
import { structuredData } from '../data/schema';

const t = getT(Astro.currentLocale);
const site = Astro.site;
if (!site) throw new Error('Falta site en astro.config.mjs');
const jsonLd = JSON.stringify(structuredData(site, Astro.currentLocale as Locale)).replaceAll('<', '\\u003c');
---

<Layout title={t('seo.title')} description={t('seo.description')}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <ScrollWorld />
  <Tagline />
  <Dishes />
  <Press />
  <Experiences />
  <Faq />
  <Gift />
  <FinalCta />
</Layout>
