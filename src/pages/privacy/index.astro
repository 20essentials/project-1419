---
export const prerender = false;

import Layout from "@/app/layout.astro";
import LegalDoc from "@/features/legal/legal-doc.astro";
import { getT } from "@/shared/i18n/t";

const t = await getT(Astro.currentLocale);
---

<Layout
  title={t("seo.legal.privacy.title")}
  description={t("seo.legal.privacy.description")}
>
  <LegalDoc id="privacy" />
</Layout>
