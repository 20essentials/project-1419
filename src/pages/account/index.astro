---
import Layout from '@/app/layout.astro';
import AccountPage from '@/features/account/account-page.astro';
import {
  getAccountOrders,
  getAccountProfile,
  type AccountOrdersResult,
  type AccountProfile,
} from '@/features/account/account-data';
import { getMemberSession, requestIsSecure } from '@/shared/auth/session';
import { getT, type Locale } from '@/shared/i18n/t';
import { localizedPathname } from '@/shared/i18n/routing';

const locale = Astro.currentLocale as Locale;
const t = getT(locale);

const accountPath = localizedPathname('/account/', locale);
const loginPath = localizedPathname('/login/', locale);
const session = await getMemberSession(Astro.cookies, requestIsSecure(Astro.request));
if (!session) return Astro.redirect(`${loginPath}?returnTo=${encodeURIComponent(accountPath)}`);

const params = Astro.url.searchParams;
let ordersError = params.get('orders') === 'error';

let profile: AccountProfile | null = null;
let orders: AccountOrdersResult | null = null;
try {
  profile = await getAccountProfile(session);
  if (!ordersError) {
    try {
      orders = await getAccountOrders(session, profile.id);
    } catch {
      orders = null;
      ordersError = true;
    }
  }
} catch {
  profile = null;
}
---

<Layout
  title={t('seo.account.title')}
  description={t('seo.account.description')}
  noindex
  session={profile ? { name: profile.firstName || profile.nickname } : null}
>
  <AccountPage profile={profile} orders={orders} ordersError={ordersError} />
</Layout>
