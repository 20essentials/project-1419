---
export const prerender = false;

import { Picture } from "astro:assets";
import Layout from "@/app/layout.astro";
import Logo from "@/app/logo.astro";
import Icon from "@/shared/ui/icon.astro";
import { getT } from "@/shared/i18n/t";
import { links, photos } from "@/shared/site/nami";

const t = await getT(Astro.currentLocale);
---

<Layout
  title={t("seo.notFoundTitle")}
  description={t("page404.description")}
  noindex
  header={false}
>
  <section class="flex min-h-svh flex-col items-center justify-center gap-12 px-4 py-24 text-center md:flex-row md:text-left">
    <div data-reveal class="w-48 md:w-64">
      <Picture
        src={photos.wine}
        alt={t("page404.photoAlt")}
        formats={["avif", "webp"]}
        widths={[320, 512]}
        sizes="256px"
        loading="eager"
        pictureAttributes={{ class: "block" }}
        class="aspect-9/16 w-full mask-arch object-cover"
      />
    </div>
    <div class="flex max-w-md flex-col items-center gap-6 md:items-start">
      <a href="/" aria-label={t("common.backHome")}>
        <Logo class="text-2xl" />
      </a>
      <p data-reveal class="text-sm text-teja">
        {t("page404.kicker")}
      </p>
      <h1 data-reveal style="--d:100ms" class="text-4xl lg:text-5xl">
        {t("page404.heading")}
      </h1>
      <p data-reveal style="--d:200ms" class="text-base text-crema/70">
        {t("page404.body")}
      </p>
      <div
        data-reveal
        style="--d:300ms"
        class="flex flex-wrap items-center justify-center gap-4"
      >
        <a href="/" class="btn btn-ghost">
          <Icon name="arrowLeft" class="size-5" />
          <span>{t("page404.backHome")}</span>
        </a>
        <a href={links.reserve} class="btn btn-primary">
          <span>{t("common.reserveTable")}</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
