---
import { Picture } from 'astro:assets';
import Pending from '@/shared/ui/pending.astro';
import { getT, formatPrice, formatPairing } from '@/shared/i18n/t';
import { experiences, links, pairing, photos } from '@/shared/site/nami';

const t = getT(Astro.currentLocale);
---

<section id="experiences" data-spy="#experiences" aria-labelledby="exp-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-xl">
      <p data-reveal class="text-sm text-teja">{t('experiences.eyebrow')}</p>
      <h2 id="exp-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">{t('experiences.title')}</h2>
      <p data-reveal style="--d:200ms" class="mt-6 text-base text-crema/70 lg:text-lg">
        {t('experiences.body')}
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[1fr_1fr_0.9fr]">
      {
        experiences.map((exp, i) => (
          <article
            data-reveal
            style={`--d:${i * 100}ms`}
            class:list={[
              'relative flex flex-col rounded-3xl p-6 ring-1 lg:p-8',
              exp.popular ? 'ring-teja/60' : 'ring-crema/15',
            ]}
          >
            {exp.popular && (
              <p class="absolute -top-3 left-6 rounded-full bg-teja px-3 py-1 text-xs font-medium text-bg lg:left-8">
                {t('experiences.popularBadge')}
              </p>
            )}
            <h3 class="text-2xl">{t(`experiences.${exp.id}.name`)}</h3>
            <p class="mt-2 text-base text-crema/70">{t(`experiences.${exp.id}.description`)}</p>
            <p class="mt-8 flex items-baseline gap-2">
              <span class="font-display text-5xl">{formatPrice(exp.price)}</span>
              <span class="text-sm text-crema/50">{t('experiences.forTwo')}</span>
            </p>
            <p class="mt-1 text-sm text-crema/50">{t('experiences.perPerson', { price: formatPrice(exp.price / 2) })}</p>
            <div class="mt-8 flex flex-1 items-end">
              <a href={links.reserve} class="btn btn-primary"><span>{t('common.reserveTable')}</span></a>
            </div>
          </article>
        ))
      }

      <article data-reveal style="--d:200ms" class="flex flex-col items-center gap-6 rounded-3xl p-6 text-center ring-1 ring-crema/15 lg:p-8">
        <div class="mirror-frame mask-oval w-40 lg:w-48">
          <Picture
            src={photos.wine}
            alt={t('experiences.pairingPhotoAlt')}
            formats={['avif', 'webp']}
            widths={[320, 480]}
            sizes="192px"
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: 'block' }}
            class="aspect-3/4 w-full mask-oval object-cover"
          />
        </div>
        <div>
          <h3 class="text-2xl">{t('experiences.pairing.name')}</h3>
          <p class="mt-2 text-base text-crema/70">{t('experiences.pairing.description')}</p>
        </div>
        <p class="font-display text-4xl">{formatPairing(pairing.price)}</p>
      </article>
    </div>

    <Pending class="mt-8 max-w-xl">{t('experiences.pending')}</Pending>
  </div>
</section>
