---
import Icon from "@/shared/ui/icon.astro";
import Pending from "@/shared/ui/pending.astro";
import { getT } from "@/shared/i18n/t";
import { contact, faqIds, links, pendingFaqs } from "@/shared/site/nami";

const t = await getT(Astro.currentLocale);
---

<section
  id="questions"
  data-spy="#questions"
  aria-labelledby="faq-title"
  class="px-4 py-24 md:px-12 xl:px-24"
>
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <p data-reveal class="text-sm text-teja">
        {t("faq.eyebrow")}
      </p>
      <h2
        id="faq-title"
        data-reveal
        style="--d:100ms"
        class="mt-4 text-3xl lg:text-5xl"
      >
        {t("faq.title")}
      </h2>
      <p
        data-reveal
        style="--d:200ms"
        class="mt-6 max-w-sm text-base text-crema/70"
      >
        {t("faq.reachUs")}{" "}
        <a href={links.phone} class="link whitespace-nowrap">
          {contact.phone}
        </a>
        .
      </p>
    </div>

    <div class="divide-y divide-crema/10">
      {faqIds.map((id) => {
        return (
          <details data-reveal class="faq group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-xl py-6 text-left text-lg transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-teja">
              <h3 class="font-sans text-lg">{t(`faq.items.${id}.q`)}</h3>
              <Icon name="plus" class="faq-icon size-6 shrink-0 text-teja" />
            </summary>
            <div class="pb-6">
              <p class="max-w-2xl text-base text-crema/70">
                {t(`faq.items.${id}.a`)}
              </p>
            </div>
          </details>
        );
      })}
      {pendingFaqs.map((id) => (
        <Pending class="my-4">{t(`pending.${id}`)}</Pending>
      ))}
    </div>
  </div>
</section>
