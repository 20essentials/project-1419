---
import Icon from '@/shared/ui/icon.astro';
import Spiral from '@/shared/ui/spiral.astro';
import { getT, type Locale } from '@/shared/i18n/t';
import { localizedPathname } from '@/shared/i18n/routing';
import type { AccountOrdersResult, AccountProfile } from './account-data';

interface Props {
  profile: AccountProfile | null;
  orders: AccountOrdersResult | null;
  ordersError?: boolean;
}

const { profile, orders, ordersError = false } = Astro.props;
const locale = Astro.currentLocale as Locale;
const t = getT(locale);

const params = Astro.url.searchParams;
const saved = params.get('saved') === '1';
const formError = params.get('error') === 'profile' ? 'profile' : params.get('error') === 'invalid' ? 'invalid' : null;

const homeHref = localizedPathname('/', locale);
const giftHref = localizedPathname('/gift/', locale);
const profileAction = '/api/account/profile';

const displayName = (profile?.firstName || profile?.nickname || '').trim();
const shortName = displayName.length > 20 ? `${displayName.slice(0, 19)}…` : displayName;

const localeTags: Record<Locale, string> = { en: 'en-GB', es: 'es-ES', it: 'it-IT' };
const dateFormatter = new Intl.DateTimeFormat(localeTags[locale], { dateStyle: 'medium' });
const formatDate = (value: string) => {
  const time = Date.parse(value);
  return Number.isFinite(time) ? dateFormatter.format(time) : '—';
};

const statusLabel = (status: string) => {
  const key = `account.orders.status.${status}`;
  const label = t(key);
  return label === key ? status.toLowerCase() : label;
};

const inputClass =
  'mt-2 w-full rounded-2xl bg-crema/5 px-4 py-3 text-base ring-1 ring-crema/15 outline-none transition-shadow duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] placeholder:text-crema/30 focus:ring-2 focus:ring-teja';
const rowClass = 'flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4';
---

<section class="relative overflow-hidden px-4 pt-40 pb-24 md:px-12 xl:px-24">
  <Spiral
    rings={12}
    class="pointer-events-none absolute top-0 right-0 w-[560px] translate-x-1/3 -translate-y-1/3 text-crema/10"
  />
  <div class="relative mx-auto max-w-3xl text-center">
    <p data-reveal class="text-sm text-teja">{t('account.eyebrow')}</p>
    <h1 data-reveal style="--d:100ms" class="mt-4 text-4xl lg:text-5xl">
      {profile ? t('account.title', { name: shortName || t('account.nav') }) : t('account.fatal.title')}
    </h1>
    <p data-reveal style="--d:200ms" class="mx-auto mt-6 max-w-lg text-base text-crema/70 lg:text-lg">
      {profile ? t('account.body') : t('account.fatal.body')}
    </p>
    {
      !profile && (
        <a data-reveal style="--d:300ms" href={homeHref} class="btn btn-primary mt-10">
          <span>{t('account.fatal.cta')}</span>
        </a>
      )
    }
  </div>

  {
    profile && (
      <div class="relative mx-auto mt-16 grid max-w-4xl gap-6 lg:grid-cols-2">
        <div
          data-reveal
          class="rounded-3xl bg-bg/60 p-6 ring-1 ring-crema/10 backdrop-blur-xl md:p-10"
        >
          <div class="flex items-center gap-4">
            <span
              class="mask-oval flex size-14 shrink-0 items-center justify-center bg-crema/10 font-display text-xl text-crema ring-1 ring-crema/15"
              aria-hidden="true"
            >
              {profile.initials}
            </span>
            <div class="min-w-0 text-left">
              <h2 class="text-2xl">{t('account.profile.title')}</h2>
              <p class="mt-1 truncate text-sm text-crema/60">{profile.email}</p>
            </div>
          </div>

          {saved && (
            <p class="mt-6 rounded-2xl bg-crema/10 px-4 py-3 text-left text-sm text-crema ring-1 ring-crema/20">
              {t('account.profile.saved')}
            </p>
          )}
          {formError && (
            <p role="alert" class="mt-6 rounded-2xl bg-teja/10 px-4 py-3 text-left text-sm text-teja ring-1 ring-teja/40">
              {formError === 'invalid' ? t('account.profile.errorInvalid') : t('account.profile.error')}
            </p>
          )}

          <dl class="mt-8 space-y-4 text-left text-sm">
            <div class="flex justify-between gap-6">
              <dt class="text-crema/50">{t('account.profile.nameLabel')}</dt>
              <dd class="text-right">{profile.firstName || '—'}</dd>
            </div>
            <div class="flex justify-between gap-6">
              <dt class="text-crema/50">{t('account.profile.lastNameLabel')}</dt>
              <dd class="text-right">{profile.lastName || '—'}</dd>
            </div>
            <div class="flex justify-between gap-6">
              <dt class="text-crema/50">{t('account.profile.phoneLabel')}</dt>
              <dd class="text-right">{profile.phone || '—'}</dd>
            </div>
          </dl>

          <details class="faq mt-8">
            <summary class="cursor-pointer list-none">
              <span class="flex items-center justify-between gap-4 rounded-2xl bg-crema/5 px-4 py-3 text-left text-sm ring-1 ring-crema/15 transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:ring-teja">
                {t('account.profile.edit')}
                <Icon name="plus" class="faq-icon size-4 shrink-0 text-crema/70" />
              </span>
            </summary>
            <form method="post" action={profileAction} class="px-1 pt-6">
              <input type="hidden" name="returnTo" value={localizedPathname('/account/', locale)} />
              <label for="account-first-name" class="block text-sm text-crema/70">
                {t('account.profile.nameLabel')}
              </label>
              <input
                id="account-first-name"
                name="firstName"
                type="text"
                autocomplete="given-name"
                maxlength="80"
                value={profile.firstName}
                placeholder="—"
                class={inputClass}
              />
              <label for="account-last-name" class="mt-5 block text-sm text-crema/70">
                {t('account.profile.lastNameLabel')}
              </label>
              <input
                id="account-last-name"
                name="lastName"
                type="text"
                autocomplete="family-name"
                maxlength="80"
                value={profile.lastName}
                placeholder="—"
                class={inputClass}
              />
              <label for="account-phone" class="mt-5 block text-sm text-crema/70">
                {t('account.profile.phoneLabel')}
              </label>
              <input
                id="account-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                maxlength="40"
                value={profile.phone}
                placeholder={t('account.profile.phonePh')}
                class={inputClass}
              />
              <button type="submit" class="btn btn-primary mt-8 w-full">
                <span>{t('account.profile.save')}</span>
              </button>
            </form>
          </details>

          <form method="post" action="/api/auth/logout" class="mt-8">
            <button type="submit" class="btn btn-ghost w-full">
              <span>{t('account.logout')}</span>
            </button>
          </form>
        </div>

        <div
          data-reveal
          style="--d:100ms"
          class="rounded-3xl bg-bg/60 p-6 ring-1 ring-crema/10 backdrop-blur-xl md:p-10"
        >
          <h2 class="text-2xl">{t('account.orders.title')}</h2>

          {ordersError && (
            <p role="alert" class="mt-6 rounded-2xl bg-teja/10 px-4 py-3 text-left text-sm text-teja ring-1 ring-teja/40">
              {t('account.orders.error')}
            </p>
          )}

          {
            !ordersError && orders?.state === 'ready' && orders.orders.length > 0 && (
              <ul class="mt-6 divide-y divide-crema/10 text-sm">
                {orders.orders.map((order) => (
                  <li class={rowClass}>
                    <div class="min-w-0 flex-1 text-left">
                      <p class="font-sans text-xs tracking-widest text-crema/50 uppercase">
                        {t('account.orders.date')} · {formatDate(order.date)}
                      </p>
                      <p class="mt-1 text-base text-crema">
                        {t('account.nav')} #{order.number}
                      </p>
                      <p class="mt-1 truncate text-crema/60">{order.items.join(' · ') || '—'}</p>
                    </div>
                    <div class="flex items-center gap-3">
                      <span class="rounded-full bg-crema/5 px-3 py-1 text-xs text-crema/70 ring-1 ring-crema/15">
                        {statusLabel(order.status)}
                      </span>
                      <span class="text-base">{order.total || '—'}</span>
                    </div>
                  </li>
                ))}
              </ul>
            )
          }

          {
            !ordersError && orders?.state === 'empty' && (
              <div class="mt-10 text-center">
                <p class="text-base text-crema/70">{t('account.orders.empty.title')}</p>
                <p class="mx-auto mt-2 max-w-xs text-sm text-crema/50">{t('account.orders.empty.body')}</p>
                <a href={giftHref} class="btn btn-primary mt-8">
                  <Icon name="gift" class="size-5" />
                  <span>{t('account.orders.empty.cta')}</span>
                </a>
              </div>
            )
          }
        </div>
      </div>
    )
  }
</section>
