---
import { Picture } from 'astro:assets';
import Pending from '@/shared/ui/pending.astro';
import Stop from './stop.astro';
import { getT, formatPrice, formatPairing } from '@/shared/i18n/t';
import { links, tour } from '@/shared/site/nami';

const t = getT(Astro.currentLocale);
const { stops } = tour;
const body = 'mt-4 max-w-md text-base text-crema/80 lg:text-lg';
const title = 'mt-4 max-w-xl text-4xl lg:text-5xl xl:text-6xl';
const pill = 'rounded-full bg-bg/40 px-3 py-1 ring-1 ring-crema/20 backdrop-blur-md';
---

<section id="tour" data-world aria-label={t('world.ariaLabel')} class="relative">
  <!-- Fixed stage: the tour clips fill the screen. Below, the first frame of each clip, framed
       exactly the same, so the video kicks in without a visible swap. -->
  <div data-stage class="sticky top-0 h-lvh overflow-hidden bg-bg" style="--focus-x: 50%">
    <div aria-hidden="true" class="absolute inset-0">
      {
        stops.map((stop, i) => (
          <div data-frame class="frame absolute inset-0" style={i === 0 ? undefined : 'opacity: 0'}>
            <Picture
              src={stop.poster}
              alt=""
              formats={['avif', 'webp']}
              widths={[828, 1280, 1920]}
              sizes="(min-aspect-ratio: 16/9) 100vw, 178vh"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
              pictureAttributes={{ class: 'block size-full' }}
              class="size-full object-cover"
              style="object-position: var(--focus-x) 50%"
            />
          </div>
        ))
      }
      <div class="clips absolute inset-0">
        {
          stops.map((stop) => (
            <video
              data-clip
              data-src={stop.clip}
              muted
              playsinline
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              tabindex="-1"
              class="clip absolute inset-0 size-full object-cover"
            />
          ))
        }
      </div>
    </div>

    <!-- Veils so the text stays readable on top of the video. -->
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-40 bg-linear-to-b from-bg/60 to-transparent"></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-t from-bg from-15% via-bg/50 via-50% to-transparent to-80% lg:bg-linear-to-r lg:from-bg/90 lg:via-bg/40 lg:via-35% lg:to-transparent lg:to-65%"
    >
    </div>
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 hidden h-1/2 bg-linear-to-t from-bg/80 to-transparent lg:block"></div>

    <!-- Stops rail. -->
    <nav aria-label={t('rail.stops')} class="absolute top-1/2 right-6 hidden -translate-y-1/2 lg:block xl:right-8">
      <ol class="relative flex flex-col items-end gap-4">
        <span aria-hidden="true" class="absolute top-3 right-1 bottom-3 w-px translate-x-1/2 bg-crema/20">
          <span data-rail-fill class="absolute inset-0 origin-top scale-y-0 bg-teja"></span>
        </span>
        {
          stops.map((stop, i) => (
            <li>
              <a href={`#${stop.id}`} data-goto aria-current={i === 0 ? 'true' : 'false'} class="rail-link group flex h-6 items-center gap-3">
                <span class="rail-label rounded-full bg-bg/60 px-3 py-1 text-xs whitespace-nowrap text-crema ring-1 ring-crema/10 backdrop-blur-xl">
                  {t(`stop.${stop.id}.place`)}
                </span>
                <span class="relative grid size-2 place-items-center">
                  <span class="rail-dot size-2 rounded-full bg-crema/50" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <p
      data-hint
      aria-hidden="true"
      class="absolute right-8 bottom-8 hidden items-center gap-3 text-xs tracking-widest text-crema/70 uppercase lg:flex"
    >
      {t('rail.hint')}
      <span class="hint-line relative block h-8 w-px overflow-hidden bg-crema/20"></span>
    </p>
  </div>

  <!-- Stops: each one leaves its text at the bottom left while the tour moves on. -->
  <div class="relative z-10 -mt-[100lvh]">
    <Stop index={0} spy="#intro">
      <h1 class="mt-4">
        <span class="block font-sans text-xs font-medium tracking-widest text-teja uppercase">
          {t('hero.kicker')}
        </span>
        <span
          class="hero-title mt-4 block max-w-170 bg-linear-to-r from-crema to-[#b3a894] bg-clip-text pb-2 text-4xl text-transparent lg:text-6xl"
        >
          {t('hero.titleLine1')}<br /> {t('hero.titleLine2')}
        </span>
      </h1>
      <p class={body}>
        {t('hero.body')}
      </p>
      <a href={links.reserve} class="btn btn-primary mt-6"><span>{t('common.reserveTable')}</span></a>
      <ul class="mt-6 flex flex-wrap gap-2 text-xs text-crema/80" aria-label={t('hero.pillsLabel')}>
        <li class={pill}>{t('hero.pillRice')}</li>
        <li class={pill}>{t('hero.pillAnisakis')}</li>
        <li class={pill}>{t('hero.pillSoy')}</li>
      </ul>
    </Stop>

    <Stop index={1} eyebrow={t('stop.nikkei.eyebrow')}>
      <h2 class={title}>{t('stop.nikkei.title')}</h2>
      <p class={body}>
        {t('stop.nikkei.body')}
      </p>
      <p class="mt-4 max-w-md text-sm text-crema/60">
        {t('stop.nikkei.team')}
      </p>
    </Stop>

    <Stop index={2} eyebrow={t('stop.pricing.eyebrow')}>
      <h2 class={title}>{t('stop.pricing.title')}</h2>
      <p class={body}>{t('stop.pricing.body')}</p>
      <dl class="mt-6 grid w-full max-w-md grid-cols-3 gap-4">
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-xs text-crema/60">{t('stop.pricing.shortLabel')}</dt>
          <dd class="font-display text-2xl lg:text-4xl">{formatPrice(150)}</dd>
        </div>
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-xs text-crema/60">{t('stop.pricing.fullLabel')}</dt>
          <dd class="font-display text-2xl lg:text-4xl">{formatPrice(250)}</dd>
        </div>
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-xs text-crema/60">{t('stop.pricing.pairingLabel')}</dt>
          <dd class="font-display text-2xl lg:text-4xl">{formatPairing(100)}</dd>
        </div>
      </dl>
      <a href="#experiences" class="link mt-6 text-sm">{t('stop.pricing.viewMenus')}</a>
    </Stop>

    <Stop index={3} eyebrow={t('stop.produce.eyebrow')}>
      <h2 class={title}>{t('stop.produce.title')}</h2>
      <p class={body}>
        {t('stop.produce.body')}
      </p>
      <ul class="mt-6 grid w-full max-w-md grid-cols-2 gap-4">
        <li class="flex flex-col gap-1 rounded-2xl bg-bg/40 p-4 ring-1 ring-crema/15 backdrop-blur-md">
          <span class="font-display text-2xl lg:text-3xl">{t('stop.produce.stat1.value')}</span>
          <span class="text-xs text-crema/70 lg:text-sm">{t('stop.produce.stat1.label')}</span>
        </li>
        <li class="flex flex-col gap-1 rounded-2xl bg-bg/40 p-4 ring-1 ring-crema/15 backdrop-blur-md">
          <span class="font-display text-2xl lg:text-3xl">{t('stop.produce.stat2.value')}</span>
          <span class="text-xs text-crema/70 lg:text-sm">{t('stop.produce.stat2.label')}</span>
        </li>
      </ul>
    </Stop>

    <Stop index={4} eyebrow={t('stop.shari.eyebrow')}>
      <h2 class={title}>{t('stop.shari.title')}</h2>
      <p class={body}>
        {t('stop.shari.body')}
      </p>
      <div class="mt-6 flex items-end gap-4">
        <span class="font-display text-5xl text-teja lg:text-7xl">1937</span>
        <span class="max-w-48 pb-1 text-sm text-crema/70">{t('stop.shari.yearNote')}</span>
      </div>
    </Stop>

    <Stop index={5} eyebrow={t('stop.howItWorks.eyebrow')}>
      <h2 class={title}>{t('stop.howItWorks.title')}</h2>
      <ol class="mt-6 flex max-w-md flex-col gap-4">
        <li class="flex gap-4">
          <span class="font-display text-2xl text-teja">1</span>
          <div>
            <h3 class="text-lg">{t('stop.howItWorks.step1Title')}</h3>
            <p class="text-sm text-crema/70">{t('stop.howItWorks.step1Body')}</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="font-display text-2xl text-teja">2</span>
          <div>
            <h3 class="text-lg">{t('stop.howItWorks.step2Title')}</h3>
            <p class="text-sm text-crema/70">{t('stop.howItWorks.step2Body')}</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="font-display text-2xl text-teja">3</span>
          <div>
            <h3 class="text-lg">{t('stop.howItWorks.step3Title')}</h3>
            <p class="text-sm text-crema/70">{t('stop.howItWorks.step3Body')}</p>
          </div>
        </li>
      </ol>
      <Pending class="mt-4 max-w-md">{t('pending.faqExperiences')}</Pending>
      <a href={links.reserve} class="btn btn-primary mt-6"><span>{t('common.reserveTable')}</span></a>
    </Stop>
  </div>
</section>

<style>
  .frame {
    will-change: opacity, transform;
  }

  .clips {
    opacity: 0;
    transition: opacity 1200ms var(--ease-fluid);
  }

  [data-mode='video'] .clips {
    opacity: 1;
  }

  /* Only the current segment clip shows; swaps between clips are instant because they share a frame. */
  .clip {
    object-position: var(--focus-x) 50%;
    visibility: hidden;
  }

  .clip.is-shown {
    visibility: visible;
  }

  .rail-label {
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      opacity 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  .rail-dot {
    transition:
      background-color 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  .rail-link:hover .rail-label,
  .rail-link:focus-visible .rail-label,
  .rail-link[aria-current='true'] .rail-label {
    opacity: 1;
    transform: none;
  }

  .rail-link:hover .rail-dot {
    background-color: var(--color-crema);
  }

  .rail-link[aria-current='true'] .rail-dot {
    background-color: var(--color-teja);
    transform: scale(1.5);
  }

  .hint-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-crema);
    animation: hint 2400ms var(--ease-fluid) infinite;
  }

  @keyframes hint {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hint-line::after {
      animation: none;
    }
  }
</style>
