---
import Spiral from '@/shared/ui/spiral.astro';
import { getT } from '@/shared/i18n/t';

const t = getT(Astro.currentLocale);
const lines = [t('tagline.line1'), t('tagline.line2'), t('tagline.line3'), t('tagline.line4')];
const text = lines.join(' ');
---

<section aria-label={t('tagline.ariaLabel')} class="relative overflow-hidden px-4 py-24 md:px-12 xl:px-24">
  <Spiral
    draw
    rings={16}
    class="pointer-events-none absolute top-1/2 left-1/2 w-[min(140vw,960px)] -translate-x-1/2 -translate-y-1/2 text-crema/10"
  />
  <div class="relative mx-auto flex min-h-[70svh] max-w-[680px] items-center justify-center">
    <p class="sr-only">{text}</p>
    <p data-words aria-hidden="true" class="font-display text-4xl text-balance lg:text-6xl">
      {
        lines.map((line) => (
          <span class="block">
            {line.split(' ').map((word) => (
              <>
                <span data-word class="word">{word}</span>{' '}
              </>
            ))}
          </span>
        ))
      }
    </p>
  </div>
</section>

<style>
  .word {
    color: color-mix(in oklab, var(--color-crema) 30%, transparent);
    transition: color 700ms var(--ease-fluid);
  }

  .word:global(.is-lit) {
    color: var(--color-crema);
  }
</style>
