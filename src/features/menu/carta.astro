---
import { Picture } from 'astro:assets';
import { getT, type Locale } from '@/shared/i18n/t';
import { links } from '@/shared/site/nami';
import { formatEuPrice } from '@/shared/site/menu-mapper';
import { getCartaData } from '@/features/menu/carta-data';

const t = getT(Astro.currentLocale);
const locale = Astro.currentLocale as Locale;
const { menu } = await getCartaData(locale);
---

<section aria-labelledby="carta-page-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-xl">
      <p data-reveal class="text-sm text-teja">{t('carta.eyebrow')}</p>
      <h1 id="carta-page-title" data-reveal style="--d:100ms" class="mt-4 text-4xl lg:text-6xl">{t('carta.title')}</h1>
      <p data-reveal style="--d:200ms" class="mt-6 text-base text-crema/70 lg:text-lg">{t('carta.pageIntro')}</p>
    </div>

    <div class="mt-16 gap-x-16 lg:columns-2">
      {
        menu.sections.map((section, i) => (
          <div data-reveal style={`--d:${Math.min(i, 3) * 100}ms`} class="mb-16 break-inside-avoid">
            <h2 class="font-display text-3xl text-teja lg:text-4xl">{section.title}</h2>
            {section.description && <p class="mt-2 text-sm text-crema/60">{section.description}</p>}
            <ol class="mt-6 divide-y divide-crema/10">
              {section.items.map((item) => (
                <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 py-4">
                  <span class="text-lg lg:text-xl">{item.title}</span>
                  {item.price !== null && (
                    <span class="font-display tabular-nums text-teja">{formatEuPrice(item.price, locale)}</span>
                  )}
                  {item.description && <p class="col-span-2 text-sm text-crema/60">{item.description}</p>}
                  {item.fotos.length > 0 && (
                    <div class="col-span-2 mt-3 flex -space-x-2">
                      {item.fotos.map((foto, j) => (
                        <Picture
                          src={foto}
                          alt=""
                          aria-hidden="true"
                          formats={['avif', 'webp']}
                          widths={[64, 128]}
                          sizes="40px"
                          loading="lazy"
                          decoding="async"
                          class="mask-oval h-12 w-10 shrink-0 object-cover ring-1 ring-teja/40"
                        />
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>

    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <p data-reveal class="text-sm text-crema/50">{t('carta.pageNote')}</p>
      <a data-reveal href={links.reservar} class="btn btn-primary"><span>{t('common.reserveTable')}</span></a>
    </div>
  </div>
</section>
