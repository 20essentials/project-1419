---
import Logo from './logo.astro';
import Icon from '@/shared/ui/icon.astro';
import { getT } from '@/shared/i18n/t';
import { contacto, legal, links, nav } from '@/shared/site/nami';

const t = getT(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="px-4 pt-24 pb-12 md:px-12 xl:px-24">
  <div class="grid gap-12 md:grid-cols-2 xl:grid-cols-4">
    <div class="flex flex-col gap-4">
      <Logo class="text-3xl self-start text-crema" />
      <p class="max-w-xs text-sm text-crema/70">{t('footer.tagline')}</p>
      <nav aria-label={t('nav.sections')}>
        <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="link">
                  {t(`nav.${item.id}`)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="flex flex-col gap-2 text-sm">
      <h2 class="font-sans text-xs tracking-widest text-crema/50 uppercase">{t('footer.visitUs')}</h2>
      <address>{contacto.calle}<br />{contacto.ciudad}</address>
      <a href={links.maps} class="link inline-flex items-center gap-2 self-start" rel="noopener" target="_blank">
        <Icon name="mapPin" />
        {t('footer.howToArrive')}
      </a>
    </div>

    <div class="flex flex-col gap-2 text-sm">
      <h2 class="font-sans text-xs tracking-widest text-crema/50 uppercase">{t('footer.hours')}</h2>
      <p>{t('contact.hoursText')}</p>
      <p class="text-crema/70">{t('contact.kitchenUntil')}</p>
    </div>

    <div class="flex flex-col gap-2 text-sm">
      <h2 class="font-sans text-xs tracking-widest text-crema/50 uppercase">{t('footer.contact')}</h2>
      <a href={links.telefono} class="link inline-flex items-center gap-2 self-start">
        <Icon name="phone" />
        {contacto.telefono}
      </a>
      <a href={links.email} class="link inline-flex items-center gap-2 self-start">
        <Icon name="envelope" />
        {contacto.email}
      </a>
      <a href={links.instagram} class="link inline-flex items-center gap-2 self-start" rel="noopener" target="_blank">
        <Icon name="instagram" />
        {contacto.instagram}
      </a>
    </div>
  </div>

  <div class="mt-16 flex flex-col gap-4 pt-8 text-xs text-crema/50 md:flex-row md:items-center md:justify-between">
    <p>{t('footer.rights', { year })}</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        legal.map((item) => (
          <li>
            <a href={item.href} class="link" rel="noopener">
              {t(`legal.${item.id}`)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
